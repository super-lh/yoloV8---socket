{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "训练插座模型 (training/train.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\training\\train.py",
            "args": [
                "--epochs",
                "80",
                "--batch",
                "8"
            ],
            "cwd": "${workspaceFolder}\\training",
            "console": "integratedTerminal",
            "python": "D:\\anaconda\\python.exe",
            "justMyCode": false,
            "exceptionHandling": "skip"
        },
